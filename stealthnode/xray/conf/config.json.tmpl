{
  // ============================================================
  // StealthNode — Xray VLESS + REALITY (шаблон).
  // install.sh подставляет @ПЛЕЙСХОЛДЕРЫ@.
  // Клиенты управляются веб-панелью (перезапись clients + restart).
  // ============================================================
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "@XRAY_ADMIN_UUID@",
            "flow": "xtls-rprx-vision",
            "email": "admin"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "@REALITY_SNI@:443",
          "xver": 0,
          "serverNames": ["@REALITY_SNI@"],
          "privateKey": "@REALITY_PRIVATE_KEY@",
          "shortIds": ["@REALITY_SHORT_ID@", ""]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      }
    }
  ],
  "outbounds": [
    { "protocol": "freedom", "tag": "direct" },
    { "protocol": "blackhole", "tag": "block" }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      { "type": "field", "ip": ["geoip:private"], "outboundTag": "block" }
    ]
  }
}
