# ============================================================
# StealthNode — Hysteria2 (резервный протокол, QUIC/UDP).
# install.sh подставляет @ПЛЕЙСХОЛДЕРЫ@.
#
# Назначение: работать там, где ТСПУ уже детектирует TCP-профиль
# VLESS, и на сетях с потерями (Brutal CC). Минусы UDP: часть
# провайдеров его троттлит/режет — поэтому это РЕЗЕРВ, а не база.
# ============================================================

# Внутри контейнера порт фиксирован; снаружи — случайный (compose)
listen: :9999

# TLS: самоподписанный сертификат (генерируется install.sh).
# Клиенты подключаются с insecure=1 + sni=домен_маскировки —
# стандартная практика для личных серверов HY2 без домена.
tls:
  cert: /etc/hysteria/server.crt
  key: /etc/hysteria/server.key

# Один пароль-аккаунт владельца (управление аккаунтами и квотами
# ведётся на Xray — там per-user статистика)
auth:
  type: password
  password: @HY2_PASSWORD@

# Обфускация Salamander: QUIC-поток превращается в «шум» без
# сигнатуры — ключевая защита от классификации ТСПУ в 2026
obfs:
  type: salamander
  salamander:
    password: @SALAMANDER_PASSWORD@

# Пассивная маскировка: на активные пробы отвечаем как прокси
# реального сайта (тот же принцип, что у REALITY)
masquerade:
  type: proxy
  proxy:
    url: https://@REALITY_SNI@
    rewriteHost: true
