# ============================================================
# StealthNode — серверный конфиг AmneziaWG (шаблон).
# install.sh подставляет @ПЛЕЙСХОЛДЕРЫ@, бэкенд затем
# перезаписывает секции [Peer] при управлении устройствами.
# ВНИМАНИЕ: файл содержит приватный ключ сервера (права 600).
# ============================================================

[Interface]
PrivateKey = @AWG_SERVER_PRIVATE_KEY@
Address = @AWG_SERVER_IP@/24
ListenPort = 51820
MTU = @AWG_MTU@

# --- Параметры обфускации AmneziaWG 3.1 ---
# Применяются entrypoint'ом через `awg set`; в клиентских конфигах
# должны быть ТЕ ЖЕ значения, иначе handshake не пройдёт.
Jc = @AWG_JC@
Jmin = @AWG_JMIN@
Jmax = @AWG_JMAX@
S1 = @AWG_S1@
S2 = @AWG_S2@
S3 = @AWG_S3@
S4 = @AWG_S4@
H1 = @AWG_H1@
H2 = @AWG_H2@
H3 = @AWG_H3@
H4 = @AWG_H4@

# --- Пиры (управляются веб-панелью; пример первого пира ниже) ---
# [Peer]
# # Имя: admin
# PublicKey = ...
# PresharedKey = ...
# AllowedIPs = 10.8.0.2/32
