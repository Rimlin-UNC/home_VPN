hysteria/conf/server.crt
hysteria/conf/server.key
caddy/Caddyfile

# Данные панели (SQLite, снапшоты трафика)
data/

# Логи торгового бота
trading-bot/logs/

# Резервные копии
backups/
*.backup.zip

# Служебное
__pycache__/
*.pyc
.DS_Store
