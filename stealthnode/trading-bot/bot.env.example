# ============================================================
# StealthNode — настройки торгового бота OKX (пример).
# install.sh создаёт реальный bot.env (права 600).
# ============================================================

# API-ключи OKX. Рекомендуется ключ с правом Trade БЕЗ вывода средств,
# привязанный к IP вашего VPS.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# true  — бумажная торговля (симуляция, реальных ордеров НЕТ);
# false — реальные спотовые ордера (осторожно!). По умолчанию true.
OKX_DRY_RUN=true

# Торговая пара (спот)
OKX_SYMBOL=BTC/USDT

# Максимальный размер ОДНОГО ордера в USDT (защитный лимит)
OKX_MAX_ORDER_USDT=10

# Параметры стратегии (простой grid/возврат к среднему)
OKX_GRID_STEP_PCT=0.5
OKX_GRID_LEVELS=4

# Пауза между циклами бота, секунд
OKX_LOOP_SEC=30
