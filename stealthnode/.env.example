# ============================================================
# StealthNode — пример файла окружения (стек: Xray + Hysteria2).
# ВНИМАНИЕ: реальный .env генерируется install.sh автоматически
# и содержит секреты. Права на него должны быть 600 (root).
# ============================================================

# --- Доступ к веб-панели ---
ADMIN_USERNAME=admin
# Пароль администратора (мин. 16 символов). Используется ТОЛЬКО при первом
# запуске: бэкенд захеширует его алгоритмом Argon2id и запишет в базу.
ADMIN_PASSWORD=change-me-min-16-symbols
# Секрет подписи JWT (генерируется: openssl rand -hex 48)
JWT_SECRET=

# Секретный путь панели, например: p-a7f3b2c1
# Панель будет доступна как https://IP:PANEL_PORT/PANEL_PATH/
PANEL_PATH=p-CHANGE_ME
# TCP-порт веб-панели (случайный из 10000-60000)
PANEL_PORT=38451
# Домен панели (опционально). Пусто — самоподписанный сертификат Caddy;
# задан — Let's Encrypt (HTTP-01, открывается порт 80).
PANEL_DOMAIN=

# --- Публичный IP сервера (определяется при установке) ---
SERVER_PUBLIC_IP=

# --- Xray VLESS + REALITY (три транспорта) ---
# Домен маскировки. НЕ google.com / microsoft.com!
# Критерии: TLS 1.3 + HTTP/2, популярен у провайдера, из «белого списка» РФ.
# Примеры: max.ru, yandex.ru, mail.ru, vk.com, ozon.ru
REALITY_SNI=max.ru
REALITY_SHORT_ID=
# UUID первого (админского) VLESS-клиента
XRAY_ADMIN_UUID=
# Внешние порты резервных транспортов (случайные)
XRAY_GRPC_PORT=44301
XRAY_XHTTP_PORT=44302
# Параметры резервных транспортов (случайные)
GRPC_SERVICE=svc-change-me
XHTTP_PATH=path-change-me

# --- Hysteria2 (резерв, QUIC/UDP + Salamander) ---
# Внешний UDP-порт (случайный из 20000-60000)
HY2_PORT=49502
HY2_PASSWORD=
SALAMANDER_PASSWORD=

# --- Торговый бот OKX (опционально) ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# true = бумажная торговля (БЕЗ реальных ордеров)
OKX_DRY_RUN=true
OKX_SYMBOL=BTC/USDT
OKX_MAX_ORDER_USDT=10
