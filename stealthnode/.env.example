# ============================================================
# StealthNode — пример файла окружения.
# ВНИМАНИЕ: реальный .env генерируется install.sh автоматически
# и содержит секреты. Права на него должны быть 600 (root).
# ============================================================

# --- Доступ к веб-панели ---
# Логин администратора
ADMIN_USERNAME=admin
# Пароль администратора (мин. 16 символов). Используется ТОЛЬКО при первом
# запуске: бэкенд захеширует его алгоритмом Argon2id и запишет в базу.
# После инициализации значение в .env ни на что не влияет.
ADMIN_PASSWORD=change-me-min-16-symbols

# Секрет подписи JWT (генерируется: openssl rand -hex 48)
JWT_SECRET=

# Секретный путь панели, например: p-a7f3b2c1
# Панель будет доступна как https://IP:PANEL_PORT/PANEL_PATH/
PANEL_PATH=p-CHANGE_ME
# TCP-порт веб-панели (случайный из диапазона 10000-60000)
PANEL_PORT=38451
# Домен для панели (опционально). Если пусто — Caddy выпустит
# самоподписанный сертификат (tls internal). Если задан — Let's Encrypt
# по HTTP-01 (нужен открытый порт 80, открывается автоматически).
PANEL_DOMAIN=

# --- Публичный IP сервера (определяется при установке) ---
SERVER_PUBLIC_IP=

# --- AmneziaWG ---
# Внешний UDP-порт AmneziaWG (случайный из 20000-60000)
AWG_PORT=47832
# Подсеть туннеля
AWG_SUBNET=10.8.0.0/24
# Адрес сервера в туннеле
AWG_SERVER_IP=10.8.0.1
# MTU туннеля (с учётом overhead обфускации)
AWG_MTU=1280
# Серверный ключ AmneziaWG (приватный; публичный выводится из него)
AWG_SERVER_PRIVATE_KEY=
AWG_SERVER_PUBLIC_KEY=
# Параметры обфускации AmneziaWG 3.1 (генерируются случайно)
AWG_JC=8
AWG_JMIN=40
AWG_JMAX=70
AWG_S1=17
AWG_S2=42
AWG_S3=0
AWG_S4=0
AWG_H1=1122334455
AWG_H2=1267890345
AWG_H3=1398765432
AWG_H4=1555666777
# Дополнительные аргументы `awg set awg0 ...` для тюнинга 3.x
# (например дополнительные тайминги/padding). Обычно пусто.
AWG_EXTRA_SET_ARGS=

# --- Xray VLESS + REALITY ---
# Домен маскировки. НЕ google.com / microsoft.com!
# Критерии: TLS 1.3, HTTP/2, популярен у провайдера, не заблокирован.
# Примеры: www.tbank.ru, www.gosuslugi.ru, ozon.ru, www.ozon.ru
REALITY_SNI=www.tbank.ru
REALITY_SHORT_ID=
# UUID первого (админского) VLESS-клиента
XRAY_ADMIN_UUID=

# --- Торговый бот OKX (опционально) ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# true = режим бумажной торговли (БЕЗ реальных ордеров, симуляция)
OKX_DRY_RUN=true
OKX_SYMBOL=BTC/USDT
# Максимальный размер одного спотового ордера, USDT (защитный лимит)
OKX_MAX_ORDER_USDT=10
