# Закреплённые версии внешних компонентов StealthNode.
# Обновление версии = правка этого файла + запись в CHANGELOG.md + прогон CI.
# shellcheck shell=bash disable=SC2034

# 3X-UI: официальный установщик с тега релиза, проверяется по SHA256.
# Хэш = sha256sum install.sh из git-тега (raw.githubusercontent.com отдаёт файл без изменений).
XUI_VERSION="v3.10.0"
XUI_INSTALL_SHA256="9684bae4f769b2127fcceceb4f200045657381311867529e6ba76c6b58e2825d"
XUI_INSTALL_URL="https://raw.githubusercontent.com/MHSanaei/3x-ui/${XUI_VERSION}/install.sh"
# Ядро Xray, которое поставляется вместе с этой версией 3x-ui (для справки и doctor).
XRAY_EXPECTED_VERSION="26.10.10"

# Caddy: официальный APT-репозиторий (Cloudsmith), ветка stable (2.x).
CADDY_GPG_URL="https://dl.cloudsmith.io/public/caddy/stable/gpg.key"
CADDY_LIST_URL="https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt"
